{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "tests/worker.test.ts",
    "tests/source.test.ts"
  ]
}
