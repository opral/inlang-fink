{
  "name": "@inlang/fink",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "demo:descriptions": "vite preview --config scripts/descriptions-demo.config.ts",
    "dev:worker": "wrangler dev",
    "build": "vite build && node scripts/prepare-assets.mjs && node scripts/build-site.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy:production": "npm run build && node scripts/deploy.mjs fink fink-migration-preview",
    "deploy:preview": "npm run build && node scripts/deploy.mjs fink-migration-preview",
    "cf:typegen": "wrangler types --strict-vars=false"
  },
  "dependencies": {
    "@inlang/editor-component": "13.0.0",
    "@inlang/plugin-i18next": "6.4.3",
    "@inlang/plugin-m-function-matcher": "2.3.3",
    "@inlang/plugin-message-format": "4.5.3",
    "@inlang/plugin-next-intl": "2.4.2",
    "@inlang/sdk": "4.0.3",
    "@inlang/settings-component": "5.0.0",
    "@lit/react": "^1.0.8",
    "@lix-js/sdk": "0.20.1",
    "@lix-js/storage-opfs": "0.20.1",
    "@shoelace-style/shoelace": "2.20.1",
    "posthog-js": "^1.438.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "marked": "^16.4.2",
    "typescript": "^5.9.3",
    "vite": "8.3.3",
    "vitest": "^4.0.0",
    "wrangler": "4.148.0"
  },
  "packageManager": "pnpm@10.23.0"
}
